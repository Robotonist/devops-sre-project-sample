[Unit]
Description=Ops Appliance API
After=ops-postgres.service ops-redis.service
Wants=ops-postgres.service ops-redis.service

[Container]
Image={{ ops_appliance_image }}:{{ ops_appliance_version }}
ContainerName=ops-api
Network=ops-network.network
EnvironmentFile={{ ops_appliance_config_dir }}/app.env
Environment=SERVICE_NAME=api
PublishPort={{ ops_appliance_api_port }}:8000
Exec=uvicorn app.main:app --host 0.0.0.0 --port 8000
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
